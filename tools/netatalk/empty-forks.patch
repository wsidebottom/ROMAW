+static void empty_sidecar_probe(AFPObj *obj, struct vol *vol, uint16_t vid)
+{
+    if (!(vol->v_ad_options & ADVOL_OSX_SIDECARS)) {
+        return;
+    }
+    assert(createfile(obj, vid, DIRDID_ROOT, "LazyPlain") == AFP_OK);
+    assert(access("LazyPlain", F_OK) == 0);
+    assert(access("._LazyPlain", F_OK) < 0);
+    char request[256] = {0}, reply[4096];
+    size_t length;
+    memcpy(request + 2, &vid, 2);
+    cnid_t root = DIRDID_ROOT;
+    memcpy(request + 4, &root, 4);
+    uint16_t bitmap = htons(1 << FILPBIT_DFLEN);
+    memcpy(request + 8, &bitmap, 2);
+    uint16_t access_bits = htons(OPENACC_RD | OPENACC_WR);
+    memcpy(request + 10, &access_bits, 2);
+    request[12] = 2;
+    request[13] = 9;
+    memcpy(request + 14, "LazyPlain", 9);
+    assert(afp_openfork(obj, request, 23, reply, &length) == AFP_OK);
+    assert(access("._LazyPlain", F_OK) < 0);
+    char close_request[4] = {0};
+    memcpy(close_request + 2, reply + 2, 2);
+    assert(afp_closefork(obj, close_request, 4, reply, &length) == AFP_OK);
+    assert(delete(obj, vid, DIRDID_ROOT, "LazyPlain") == AFP_OK);
+
+    struct adouble ad;
+    ad_init(&ad, vol);
+    FILE *file = fopen("LazyResource", "wb");
+    assert(file && !fclose(file));
+    assert(!ad_open(&ad, "LazyResource", ADFLAGS_RF | ADFLAGS_RDWR
+                   | ADFLAGS_CREATE, 0664));
+    assert(ad_write(&ad, ADEID_RFORK, 0, 0, "resource", 8) == 8);
+    assert(!ad_flush(&ad));
+    assert(!ad_close(&ad, ADFLAGS_RF));
+    assert(!unlink("LazyResource"));
+    struct stat st;
+    assert(!ad_sidecar_stat("LazyResource", vol->v_ad_options, &st));
+    assert(st.st_size == 0);
+    char create_request[64] = {0};
+    memcpy(create_request + 2, &vid, 2);
+    memcpy(create_request + 4, &root, 4);
+    create_request[8] = 2;
+    create_request[9] = 12;
+    memcpy(create_request + 10, "LazyResource", 12);
+    assert(afp_createfile(obj, create_request, 22, reply, &length) == AFPERR_EXIST);
+    assert(access("LazyResource", F_OK) < 0);
+    assert(enumerate(obj, vid, DIRDID_ROOT) == 0);
+    /* No attributes requested here: listing alone needs no share lock. */
+    assert(access("LazyResource", F_OK) < 0);
+    request[13] = 12;
+    memcpy(request + 14, "LazyResource", 12);
+    assert(afp_openfork(obj, request, 26, reply, &length) == AFP_OK);
+    assert(!lstat("LazyResource", &st) && st.st_size == 0);
+    memcpy(close_request + 2, reply + 2, 2);
+    assert(afp_closefork(obj, close_request, 4, reply, &length) == AFP_OK);
+    assert(delete(obj, vid, DIRDID_ROOT, "LazyResource") == AFP_OK);
+    assert(access("._LazyResource", F_OK) < 0);
+
+    file = fopen("LazyRename", "wb");
+    assert(file && !fclose(file));
+    ad_init(&ad, vol);
+    assert(!ad_open(&ad, "LazyRename", ADFLAGS_RF | ADFLAGS_RDWR
+                   | ADFLAGS_CREATE, 0664));
+    assert(ad_write(&ad, ADEID_RFORK, 0, 0, "rename", 6) == 6);
+    assert(!ad_flush(&ad) && !ad_close(&ad, ADFLAGS_RF));
+    assert(!unlink("LazyRename"));
+    memset(request, 0, sizeof request);
+    memcpy(request + 2, &vid, 2);
+    memcpy(request + 4, &root, 4);
+    request[8] = 2;
+    request[9] = 10;
+    memcpy(request + 10, "LazyRename", 10);
+    request[20] = 2;
+    request[21] = 11;
+    memcpy(request + 22, "LazyRenamed", 11);
+    assert(afp_rename(obj, request, 33, reply, &length) == AFP_OK);
+    assert(access("._LazyRename", F_OK) < 0);
+    assert(!unlink("LazyRenamed"));
+    assert(delete(obj, vid, DIRDID_ROOT, "LazyRenamed") == AFP_OK);
+    assert(access("._LazyRenamed", F_OK) < 0);
+    puts("EMPTY_SIDECAR_AFP_PROBE_OK");
+}
 
