+/* Validate a resource-only catalog entry without creating its data fork.
+ * Use the volume's format; never reinterpret arbitrary dot files as files. */
+int ad_sidecar_stat(const char *path, int options, struct stat *st)
+{
+    const char *sidecar = options & ADVOL_OSX_SIDECARS
+                        ? ad_path_osx_sidecar(path, 0) : ad_path(path, 0);
+    if (!sidecar) {
+        return -1;
+    }
+    int fd = open(sidecar, O_RDONLY | O_NOFOLLOW);
+    if (fd < 0) {
+        return -1;
+    }
+    unsigned char header[26];
+    uint32_t magic, version;
+    uint16_t count;
+    int result = -1, found = 0;
+    if (fstat(fd, st) || !S_ISREG(st->st_mode)
+            || pread(fd, header, sizeof header, 0) != sizeof header) {
+        goto done;
+    }
+    memcpy(&magic, header, 4);
+    memcpy(&version, header + 4, 4);
+    memcpy(&count, header + 24, 2);
+    count = ntohs(count);
+    if (ntohl(magic) != AD_MAGIC || ntohl(version) != AD_VERSION2
+            || !count || count > 64 || 26 + count * 12 > st->st_size) {
+        goto done;
+    }
+    for (unsigned i = 0; i < count; ++i) {
+        uint32_t entry[3];
+        if (pread(fd, entry, sizeof entry, 26 + i * 12) != sizeof entry) {
+            goto done;
+        }
+        uint32_t id = ntohl(entry[0]), off = ntohl(entry[1]);
+        uint32_t len = ntohl(entry[2]);
+        if (off < 26 + count * 12
+                || (len && ((uint64_t)off + len > (uint64_t)st->st_size))) {
+            goto done;
+        }
+        if (id == 2 || (id == 9 && len >= 32)) {
+            found = 1;
+        }
+    }
+    if (found) {
+        st->st_size = 0;
+        result = 0;
+    }
+done:
+    close(fd);
+    if (result) {
+        errno = ENOENT;
+    }
+    return result;
+}
+
+/* AFP share modes and CNIDs need a stable main-file inode. This is a required
+ * anchor, created on access rather than merely while listing a directory. */
+int ad_ensure_data_anchor(const char *path, int options)
+{
+    struct stat st;
+    if (lstat(path, &st) == 0) {
+        return 0;
+    }
+    if (errno != ENOENT || ad_sidecar_stat(path, options, &st) < 0) {
+        return -1;
+    }
+    int fd = open(path, O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW,
+                  st.st_mode & 0777);
+    if (fd < 0) {
+        return errno == EEXIST ? 0 : -1;
+    }
+    struct timespec times[2] = { st.st_atim, st.st_mtim };
+    (void)futimens(fd, times);
+    return close(fd);
+}
