// First-start defaults. Maintain this file directly; existing user prefs are preserved.
// Per-application DisplayScale is a percentage: 100=1x, 150=1.5x, 200=2x,
// 400=4x, 800=8x. Custom values 25..1600 are supported; omitted means 100.

// Windows drives are DOS by default. On first graphical startup, select drives
// that support Mac sidecars. A saved value of none suppresses the setup prompt.
// Example: SidecarDrives=M,S,Y. The mapped Apps folder always supports OSX
// sidecars, independently of the containing drive. Clear this value to reselect.
[HostDrives]
SidecarDrives=
MacDirectoryCount=0
// MacDirectory1=C:/Classic Games
// MacDirectory2=Y:/Macintosh Archive
// Increase MacDirectoryCount to match the number of directory entries.
// Compatible folders mount as independent volumes at the next startup.
// Guest volume names are saved separately under [HostVolumeNames], keyed by
// host root path. Renaming a volume never changes a Windows disk/folder name.

